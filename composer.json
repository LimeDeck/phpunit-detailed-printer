{
    "name": "limedeck/phpunit-detailed-printer",
    "description": "Formatter for the detailed output of PHPUnit tests.",
    "license": "ISC",
    "authors": [
        {
            "name": "LimeDeck",
            "email": "mail@limedeck.io"
        }
    ],
    "require": {
        "php": ">=8.3",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3"
    },
    "autoload": {
        "psr-4": {
            "LimeDeck\\Testing\\": "src/"
        }
    },
    "scripts": {
      "cs:check": "vendor/bin/php-cs-fixer fix --verbose --ansi --show-progress=dots --diff --dry-run",
      "cs:fix": "vendor/bin/php-cs-fixer fix --verbose --ansi --show-progress=dots"
    },
    "minimum-stability": "stable"
}
